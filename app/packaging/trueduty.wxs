<?xml version="1.0" encoding="utf-8"?>
<!-- Windows Installer package (.msi) for TrueDuty. Built by windows.ps1 with WiX Toolset 5:
     wix build -arch x64|arm64 -ext WixToolset.UI.wixext -d Version=.. -d SrcDir=.. -d Icon=.. -d License=.. trueduty.wxs files.wxs
     files.wxs (every file of the standalone build) is generated by windows.ps1.
     Installs per machine into Program Files\TrueDuty, adds Start menu and optional desktop shortcuts, upgrades older
     versions in place (same UpgradeCode), and shows up in Apps and features with icon, publisher and links.
     Silent install for IT:  msiexec /i TrueDuty-<v>-windows-x64.msi /qn   (add DESKTOP_SHORTCUT=0 to skip the desktop icon) -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TrueDuty" Manufacturer="QudsLab" Version="$(var.Version)" UpgradeCode="6E3B1C52-7A8F-4E1D-9B57-2F0C8D4A1E93"
           Scope="perMachine" Compressed="yes" Language="1033" InstallerVersion="500">
    <SummaryInformation Description="TrueDuty time tracker $(var.Version)" Manufacturer="QudsLab" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of TrueDuty is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/QudsLab/TrueDuty" />
    <Property Id="ARPHELPLINK" Value="https://github.com/QudsLab/TrueDuty/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/QudsLab/TrueDuty/releases/latest" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="TrueDuty" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuTrueDuty" Name="TrueDuty" Description="Time and activity tracker" Target="[INSTALLFOLDER]TrueDuty.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKMU" Key="Software\QudsLab\TrueDuty" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT = 1">
      <Shortcut Id="DesktopTrueDuty" Name="TrueDuty" Target="[INSTALLFOLDER]TrueDuty.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKMU" Key="Software\QudsLab\TrueDuty" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="InstallInfo" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\QudsLab\TrueDuty" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="TrueDuty" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallInfo" />
    </Feature>

    <!-- Launch after install (checkbox on the last page) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open TrueDuty" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]TrueDuty.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
